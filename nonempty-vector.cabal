cabal-version:   3.0
name:            nonempty-vector
version:         0.3
synopsis:        Non-empty vectors
description:     Performant, non-empty mutable and immutable vectors
homepage:        https://github.com/emilypi/nonempty-vector
bug-reports:     https://github.com/emilypi/nonempty-vector/issues
license:         BSD-3-Clause
license-file:    LICENSE
author:          Emily Pillmore
maintainer:      emilypi@cohomolo.gy
copyright:       (c) 2019-2026 Emily Pillmore <emilypi@cohomolo.gy>
category:        Data
build-type:      Simple
extra-doc-files:
  CHANGELOG.md
  README.md

tested-with:
  GHC ==9.4.8
   || ==9.6.7
   || ==9.8.4
   || ==9.10.3
   || ==9.12.4
   || ==9.14.1

source-repository head
  type:     git
  location: https://github.com/emilypi/nonempty-vector.git

library
  exposed-modules:
    Data.Vector.NonEmpty
    Data.Vector.NonEmptyU
    Data.Vector.NonEmpty.Internal
    Data.Vector.NonEmpty.Mutable
    Data.Vector.NonEmpty.MutableU
    Data.Vector.NonEmpty.InternalU

  build-depends:
      base       >=4.16 && <4.23
    , deepseq    >=1.4  && <1.6
    , primitive  >=0.6  && <0.10
    , vector     >=0.12 && <0.14

  hs-source-dirs:   src
  default-language: Haskell2010
  ghc-options:      -Wall

test-suite tasty
  default-language:  Haskell2010
  type:              exitcode-stdio-1.0
  main-is:           Main.hs
  other-modules:
    Test.Data.Vector.NonEmpty.Accessors
    Test.Data.Vector.NonEmpty.AccessorsU
    Test.Data.Vector.NonEmpty.Construction
    Test.Data.Vector.NonEmpty.ConstructionU
    Test.Data.Vector.NonEmpty.Conversion
    Test.Data.Vector.NonEmpty.ConversionU
    Test.Data.Vector.NonEmpty.Elementwise
    Test.Data.Vector.NonEmpty.ElementwiseU
    Test.Data.Vector.NonEmpty.Folds
    Test.Data.Vector.NonEmpty.FoldsU
    Test.Data.Vector.NonEmpty.Grouping
    Test.Data.Vector.NonEmpty.GroupingU
    Test.Data.Vector.NonEmpty.Instances
    Test.Data.Vector.NonEmpty.InstancesU
    Test.Data.Vector.NonEmpty.Modification
    Test.Data.Vector.NonEmpty.ModificationU
    Test.Data.Vector.NonEmpty.Mutable
    Test.Data.Vector.NonEmpty.MutableU
    Test.Data.Vector.NonEmpty.Predicates
    Test.Data.Vector.NonEmpty.PredicatesU
    Test.Data.Vector.NonEmpty.Scans
    Test.Data.Vector.NonEmpty.ScansU
    Test.Data.Vector.NonEmpty.Util

  build-depends:
      base     >=4.16 && <4.23
    , deepseq
    , nonempty-vector
    , QuickCheck
    , tasty
    , tasty-quickcheck
    , vector

  hs-source-dirs:    test
  ghc-options:       -Wall -threaded
